# Local preview of the GitHub Pages site (the live site is built by GitHub):
#   cd docs && bundle install && bundle exec jekyll serve --baseurl ''
# The github-pages gem pins the exact Jekyll + plugin versions GitHub Pages runs.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick" # Ruby 3 no longer bundles webrick (needed by `jekyll serve`)
